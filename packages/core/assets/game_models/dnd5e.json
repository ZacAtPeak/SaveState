        {"key": "alignment", "label": "Alignment", "inputType": "select", "required": true, "enumOptions": ["Lawful Good", "Neutral Good", "Chaotic Good", "Lawful Neutral", "True Neutral", "Chaotic Neutral", "Lawful Evil", "Neutral Evil", "Chaotic Evil"]},
