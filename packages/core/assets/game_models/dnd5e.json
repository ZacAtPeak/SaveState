        {"key": "creatureType", "label": "Creature Type", "inputType": "text", "required": true, "hint": "Humanoid, Beast, Fiend..."},
        {"key": "armorClass", "label": "Armor Class", "inputType": "number", "required": true},
        {"key": "hitPoints", "label": "Hit Points", "inputType": "number", "required": true},
        {"key": "speed", "label": "Speed", "inputType": "text", "hint": "30 ft., fly 60 ft."},
        {"key": "challengeRating", "label": "Challenge Rating", "inputType": "text", "hint": "e.g. 1/4, 5, 12"}
