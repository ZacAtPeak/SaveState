        {"key": "school", "label": "School", "inputType": "select", "required": true, "enumOptions": ["Abjuration", "Conjuration", "Divination", "Enchantment", "Evocation", "Illusion", "Necromancy", "Transmutation"]},
        {"key": "castingTime", "label": "Casting Time", "inputType": "text", "required": true},
